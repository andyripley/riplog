{
  "name": "riplog",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "^24.11.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt build && wrangler d1 migrations apply DB --local --persist-to .wrangler/state --config .output/server/wrangler.json && wrangler dev --cwd .output --persist-to ../.wrangler/state",
    "deploy": "pnpm build && pnpm run deploy:cloudflare",
    "deploy:cloudflare": "sh -c 'pnpm exec wrangler --cwd .output/server d1 migrations apply DB --remote && pnpm exec wrangler --cwd .output deploy --keep-vars'",
    "check": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "nuxt db generate",
    "prepare": "nuxt prepare"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@libsql/client": "^0.15.15",
    "@nuxt/content": "^3.16.1",
    "@nuxthub/core": "^0.10.8",
    "@nuxtjs/robots": "^5.5.8",
    "@nuxtjs/sitemap": "^7.4.7",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.44.7",
    "nuxt": "^4.5.2",
    "nuxt-studio": "^1.7.0",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@types/node": "^24.13.6",
    "drizzle-kit": "^0.31.8",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.3",
    "wrangler": "^4.137.0",
    "zod": "^4.6.5"
  }
}
