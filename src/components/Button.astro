---
/** Beveled Win95-style button. Renders <a> when `href` is set, else <button>. */
interface Props {
  href?: string;
  type?: "button" | "submit" | "reset";
}
const { href, type = "button" } = Astro.props;
---

{href ? (
  <a class="btn" href={href}>
    <slot />
  </a>
) : (
  <button class="btn" type={type}>
    <slot />
  </button>
)}

<style>
  .btn {
    display: inline-block;
    font-family: var(--font-sys);
    font-size: 14px;
    color: var(--bg-dark);
    background: var(--silver);
    border: 2px outset var(--text);
    padding: 3px 10px;
    text-decoration: none;
    cursor: pointer;

    &:active {
      border-style: inset;
    }
  }
</style>
