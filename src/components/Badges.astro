---
/** CSS-built 88x31 buttons. Swap in real ones from your collection! */
const badges = [
  {
    text: "Github",
    href: "https://github.com/andyripley",
    bg: "var(--bg-dark)",
    fg: "var(--white)",
  },
  {
    text: "LinkedIn",
    href: "https://www.linkedin.com/in/andrew-ripley-25a8135a",
    bg: "var(--blue)",
    fg: "var(--bg-dark)",
  },
];
---

<div class="badges">
  {badges.map((b) => {
    const style = `background:${b.bg};color:${b.fg}`;
    return b.href ? (
      <a class="badge" href={b.href} style={style} rel="noopener">
        {b.text}
      </a>
    ) : (
      <span class="badge" style={style}>
        {b.text}
      </span>
    );
  })}
</div>

<style>
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    justify-content: center;
  }
  .badge {
    width: 88px;
    height: 31px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font: bold 11px/1.05 var(--font-sys);
    text-transform: uppercase;
    border: 2px outset var(--border);
    text-decoration: none;
    overflow: hidden;
    image-rendering: pixelated;
  }
  a.badge:hover {
    border-style: inset;
  }
</style>
