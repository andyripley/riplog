---
/** Fake webring nav. Point these at a real ring later. */
interface Props {
  name?: string;
  prev?: string;
  next?: string;
  random?: string;
  home?: string;
}
const {
  name = "The Astro Cyber Ring",
  prev = "#",
  next = "#",
  random = "#",
  home = "#",
} = Astro.props;
---

<nav class="webring" aria-label="Webring">
  <div>
    This site is a proud member of <b>{name}</b>
  </div>
  <div class="links">
    [<a href={prev}>&laquo; Prev</a>] [<a href={random}>Random</a>] [
    <a href={home}>Ring Home</a>] [<a href={next}>Next &raquo;</a>]
  </div>
</nav>

<style>
  .webring {
    margin: 1em auto;
    max-width: 480px;
    border: 3px ridge var(--accent);
    background: var(--bg-highlight);
    padding: 0.5em;
    font-family: var(--font-sys);
    font-size: 14px;
    text-align: center;
  }
  .links {
    margin-top: 0.3em;
  }
</style>
