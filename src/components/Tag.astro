---
interface Props {
  variant?: "default" | "draft";
}
const { variant = "default" } = Astro.props;
---

<span class:list={["tag", { draft: variant === "draft" }]}>
  <slot />
</span>

<style>
  .tag {
    display: inline-block;
    font: 12px var(--font-mono);
    border: 1px solid var(--link);
    padding: 0 4px;
    margin-right: 4px;
  }
  .draft {
    color: var(--red);
  }
</style>
