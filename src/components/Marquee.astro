---
/**
 * CSS-animated stand-in for the obsolete <marquee> tag.
 * Pauses on hover/focus; static and wrapping under prefers-reduced-motion.
 */
interface Props {
  direction?: "left" | "right";
  behavior?: "scroll" | "alternate";
  /** Seconds per pass; defaults to 18 for scroll and 12 for alternate. */
  duration?: number;
  color?: string;
}
const {
  direction = "left",
  behavior = "scroll",
  duration,
  color = "var(--lime)",
} = Astro.props;
const resolvedDuration = duration ?? (behavior === "scroll" ? 18 : 12);
---

<div
  class:list={["marquee", behavior, direction]}
  style={`--marquee-color:${color};--marquee-duration:${resolvedDuration}s`}
>
  <span class="track">
    <slot />
  </span>
</div>

<style>
  .marquee {
    container-type: inline-size;
    overflow: hidden;
    white-space: nowrap;
    color: var(--marquee-color);
    font-family: var(--font-display);

    &:hover .track,
    &:focus-within .track {
      animation-play-state: paused;
    }
  }

  .track {
    display: inline-block;
    animation: marquee-scroll var(--marquee-duration) linear infinite;
  }

  .alternate .track {
    animation-name: marquee-bounce;
    animation-timing-function: ease-in-out;
    animation-direction: alternate;
  }

  .right .track {
    animation-direction: reverse;
  }
  .right.alternate .track {
    animation-direction: alternate-reverse;
  }

  /* Enter from the right edge, exit fully off the left edge */
  @keyframes marquee-scroll {
    from {
      transform: translateX(100cqw);
    }
    to {
      transform: translateX(-100%);
    }
  }

  /* Bounce between the left and right edges */
  @keyframes marquee-bounce {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(100cqw - 100%));
    }
  }

  /* Global rule already disables the animation; let text wrap instead of clipping */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      white-space: normal;
    }
  }
</style>
