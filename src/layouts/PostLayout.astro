---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import { formatDate } from "../lib/posts";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const {
  title,
  description,
  pubDate,
  updatedDate,
  tags,
  mood,
  nowPlaying,
  draft,
} = post.data;
---

<BaseLayout title={title} description={description}>
  <article class="prose">
    <p>
      <a href="/blog/">&laquo; Back to the Web Log</a>
    </p>
    <h1 class="gradient-text">{title}</h1>
    {draft && (
      <p class="blink" style="color:var(--red)">
        *** DRAFT - only visible in dev ***
      </p>
    )}
    <div class="post-meta">
      <div>
        <b>Posted:</b>{" "}
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      </div>
      {updatedDate && (
        <div>
          <b>Updated:</b>{" "}
          <time datetime={updatedDate.toISOString()}>
            {formatDate(updatedDate)}
          </time>
        </div>
      )}
      {mood && (
        <div>
          <b>Current mood:</b> {mood}
        </div>
      )}
      {nowPlaying && (
        <div>
          <b>Now playing:</b> {nowPlaying}
        </div>
      )}
      {tags.length > 0 && (
        <div>
          <b>Tags:</b>{" "}
          {tags.map((t) => (
            <span class="tag">{t}</span>
          ))}
        </div>
      )}
    </div>

    <slot />

    <hr class="rainbow" />
    <p class="center">
      <a class="bevel-btn" href="/blog/">
        &laquo; More posts
      </a>
      <a class="bevel-btn" href="/guestbook/">
        Sign my guestbook!
      </a>
    </p>
  </article>
</BaseLayout>
