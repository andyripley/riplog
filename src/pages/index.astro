---
import BaseLayout from "../layouts/BaseLayout.astro";
import Blink from "../components/Blink.astro";
import Button from "../components/Button.astro";
import PostList from "../components/PostList.astro";
import Rainbow from "../components/Rainbow.astro";
import UnderConstruction from "../components/UnderConstruction.astro";
import { SITE } from "../consts";
import { getPosts } from "../lib/posts";

const posts = (await getPosts()).slice(0, 5);
---

<BaseLayout>
  <h2>Latest Blog Post</h2>
  {posts.length === 0 && <p>No posts yet. Check back soon!</p>}
  <PostList posts={posts} />
  <p class="center">
    <Button href="/blog/">View all entries &raquo;</Button>
  </p>

  <UnderConstruction message="Pardon our dust! New stuff is added all the time." />
</BaseLayout>
