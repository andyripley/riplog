---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import UnderConstruction from "../components/UnderConstruction.astro";
---

<BaseLayout title="Guestbook" description="Sign my guestbook!">
  <h1 class="rainbow-text">Sign My Guestbook!</h1>
  <p>
    Let me know you stopped by! Tell me where you're from and how you found my
    page.
  </p>

  <UnderConstruction message="The guestbook CGI script is still being written. Check back soon!">
    <p style="font-size:14px">
      (Future: a Workers endpoint + KV/D1 goes here.)
    </p>
  </UnderConstruction>

  <form
    class="center"
    onsubmit="alert('Guestbook coming soon!'); return false;"
  >
    <p>
      <label>
        Name: <input name="name" size="30" />
      </label>
    </p>
    <p>
      <label>
        Homepage URL: <input name="url" size="30" />
      </label>
    </p>
    <p>
      <label>
        Comments:
        <br />
        <textarea name="msg" rows="5" cols="40"></textarea>
      </label>
    </p>
    <p>
      <Button type="submit">Sign it!</Button>
      <Button type="reset">Clear</Button>
    </p>
  </form>
</BaseLayout>
